{
  "name": "@fortnote/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content-security-policy": {
      "types": "./dist/contentSecurityPolicy.d.ts",
      "default": "./dist/contentSecurityPolicy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --config tests/vitest.config.ts tests/shared"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.8.2"
  }
}
