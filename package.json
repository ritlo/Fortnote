{
  "name": "fortnote",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "assurance": "pnpm lint && pnpm typecheck && pnpm test && pnpm e2e && pnpm assurance:accessibility && pnpm assurance:perf && pnpm assurance:verify",
    "assurance:accessibility": "playwright test --project=accessibility",
    "assurance:inventory": "node scripts/inventory-assurance.mjs",
    "assurance:mutation": "stryker run && node scripts/classify-mutation-results.mjs",
    "assurance:perf": "pnpm build && node scripts/create-performance-fixture.mjs",
    "assurance:perf:full": "pnpm build && FORTNOTE_PERFORMANCE_PROFILE=full node scripts/create-performance-fixture.mjs",
    "assurance:perf:postgres": "pnpm build && node scripts/run-postgres-performance.mjs",
    "assurance:verify": "node scripts/verify-assurance.mjs",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @fortnote/client dev",
    "dev:server": "pnpm --filter @fortnote/server dev",
    "e2e": "playwright test --project=chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "test": "pnpm typecheck && pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fortnote/shared": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.5.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.9",
    "ws": "^8.21.1",
    "yjs": "^13.6.31"
  }
}
